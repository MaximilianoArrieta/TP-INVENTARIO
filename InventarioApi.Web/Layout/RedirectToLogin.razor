@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        var actual = Nav.ToBaseRelativePath(Nav.Uri);
        var destino = string.IsNullOrEmpty(actual) ? "login" : $"login?volverA={Uri.EscapeDataString(actual)}";
        Nav.NavigateTo(destino, replace: true);
    }
}
