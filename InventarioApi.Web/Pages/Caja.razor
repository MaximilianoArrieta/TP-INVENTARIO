@page "/caja"
@attribute [Authorize(Roles = "Admin,Cajero")]
@implements IDisposable
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Caja · Caja y Stock</PageTitle>

<div class="caja">
    <section class="caja-catalogo">
        <header class="encabezado">
            <h1>Caja</h1>
            <p>Escribí el nombre del producto y presioná Enter para sumarlo al ticket.</p>
        </header>

        <input @ref="buscadorRef" class="buscador-input" placeholder="Buscar producto…"
               value="@busqueda" @oninput="AlEscribir" @onkeydown="AlPresionarTecla" aria-label="Buscar producto" />

        @if (resultados.Count == 0)
        {
            <p class="vacio">@MensajeSinResultados</p>
        }
        else
        {
            <div class="grilla-productos">
                @foreach (var p in resultados)
                {
                    var disponible = p.Stock - CantidadEnTicket(p.Id);
                    <button class="producto @(disponible <= 0 ? "producto-agotado" : "")"
                            disabled="@(disponible <= 0)" @onclick="() => Agregar(p)">
                        @if (!string.IsNullOrEmpty(p.ImagenUrl))
                        {
                            <img class="producto-imagen" src="@Api.UrlArchivo(p.ImagenUrl)" alt="" />
                        }
                        else
                        {
                            <span class="producto-imagen producto-inicial" aria-hidden="true">@Inicial(p.Nombre)</span>
                        }
                        <span class="producto-nombre">@p.Nombre</span>
                        <span class="producto-precio">@Formato.Moneda(p.Precio)</span>
                        <span class="producto-stock @(disponible is > 0 and <= 5 ? "producto-stock-bajo" : "")">
                            @(disponible <= 0 ? "Sin stock" : $"Quedan {disponible}")
                        </span>
                    </button>
                }
            </div>
        }
    </section>

    <aside class="caja-ticket" aria-label="Ticket en curso">
        <div class="ticket-cliente">
            <div>
                <small>Cliente</small>
                <strong>@(cliente?.NombreCompleto ?? "Consumidor Final")</strong>
            </div>
            @if (!eligiendoCliente)
            {
                <button class="boton-link" @onclick="AbrirSelectorCliente">Cambiar</button>
            }
        </div>

        @if (eligiendoCliente)
        {
            <div class="selector-cliente">
                <input class="buscador-input buscador-chico" placeholder="Buscar cliente por nombre o email…"
                       value="@busquedaCliente" @oninput="BuscarClientes" />
                <ul>
                    <li><button @onclick="() => ElegirCliente(null)">Consumidor Final</button></li>
                    @foreach (var c in clientes.Where(x => x.NombreCompleto != "Consumidor Final"))
                    {
                        <li>
                            <button @onclick="() => ElegirCliente(c)">
                                @c.NombreCompleto <small>@c.Email</small>
                            </button>
                        </li>
                    }
                </ul>
                <button class="boton-link" @onclick="() => eligiendoCliente = false">Cancelar</button>
            </div>
        }

        @if (error != null)
        {
            <div class="alerta alerta-error">@error</div>
        }

        <div class="ticket-lineas">
            @if (carrito.Count == 0)
            {
                <p class="vacio">El ticket está vacío.</p>
            }
            @foreach (var l in carrito)
            {
                <div class="linea">
                    <div class="linea-desc">
                        <span>@l.Producto.Nombre</span>
                        <small>@Formato.Moneda(l.Producto.Precio) c/u</small>
                    </div>
                    <div class="linea-cantidad">
                        <button class="mini" @onclick="() => Cambiar(l, -1)" aria-label="Quitar uno">−</button>
                        <span>@l.Cantidad</span>
                        <button class="mini" @onclick="() => Cambiar(l, 1)" aria-label="Agregar uno"
                                disabled="@(l.Cantidad >= l.Producto.Stock)">+</button>
                    </div>
                    <div class="linea-subtotal">@Formato.Moneda(l.Subtotal)</div>
                    <button class="mini mini-quitar" @onclick="() => Quitar(l)" aria-label="Quitar del ticket">×</button>
                </div>
            }
        </div>

        <div class="ticket-total">
            <span>Total</span>
            <strong>@Formato.Moneda(Total)</strong>
        </div>

        <div class="ticket-acciones">
            <button class="boton boton-fantasma" @onclick="Vaciar" disabled="@(carrito.Count == 0 || procesando)">Vaciar</button>
            <button class="boton boton-cobrar" @onclick="Cobrar" disabled="@(carrito.Count == 0 || procesando)">
                @(procesando ? "Registrando…" : "Cobrar")
            </button>
        </div>
    </aside>
</div>

@if (ticket != null)
{
    <div class="modal-fondo">
        <div class="modal-caja" role="dialog" aria-labelledby="ticket-titulo">
            <div class="ticket-impreso">
                <h2 id="ticket-titulo">Venta registrada</h2>
                <div class="ticket-meta">
                    Ticket N.º @ticket.Id · @Formato.Fecha(ticket.Fecha)<br />
                    Cliente: @ticket.Cliente · Atendió: @ticket.Usuario
                </div>
                <table class="ticket-tabla">
                    <tbody>
                        @foreach (var d in ticket.Detalles)
                        {
                            <tr>
                                <td>@d.Cantidad × @d.Producto</td>
                                <td class="num">@Formato.Moneda(d.Subtotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="ticket-impreso-total">
                    <span>Total</span>
                    <strong>@Formato.Moneda(ticket.Total)</strong>
                </div>
            </div>
            <div class="modal-acciones">
                <button class="boton boton-fantasma" @onclick="Imprimir">Imprimir</button>
                <button class="boton boton-primario" @onclick="NuevaVenta">Nueva venta</button>
            </div>
        </div>
    </div>
}

@code {
    private class LineaCarrito
    {
        public required ProductoItem Producto { get; init; }
        public int Cantidad { get; set; }
        public decimal Subtotal => Producto.Precio * Cantidad;
    }

    private ElementReference buscadorRef;
    private string busqueda = "";
    private List<ProductoItem> resultados = new();
    private bool cargando;
    private readonly List<LineaCarrito> carrito = new();

    private ClienteItem? cliente;
    private bool eligiendoCliente;
    private string busquedaCliente = "";
    private List<ClienteItem> clientes = new();

    private string? error;
    private bool procesando;
    private VentaVista? ticket;
    private CancellationTokenSource? demora;

    private decimal Total => carrito.Sum(l => l.Subtotal);

    private string MensajeSinResultados =>
        cargando ? "Buscando…" :
        string.IsNullOrWhiteSpace(busqueda) ? "Todavía no hay productos cargados." :
        $"No hay productos que coincidan con “{busqueda.Trim()}”.";

    protected override async Task OnInitializedAsync() => await CargarProductos();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await EnfocarBuscador();
    }

    private async Task EnfocarBuscador()
    {
        try { await buscadorRef.FocusAsync(); } catch { }
    }

    private int CantidadEnTicket(int productoId) =>
        carrito.FirstOrDefault(l => l.Producto.Id == productoId)?.Cantidad ?? 0;

    private static string Inicial(string nombre) =>
        string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();

    // ---- Búsqueda de productos ----

    private async Task AlEscribir(ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString() ?? "";

        // Espera un instante a que el usuario termine de escribir
        demora?.Cancel();
        demora = new CancellationTokenSource();
        try { await Task.Delay(250, demora.Token); }
        catch (TaskCanceledException) { return; }

        await CargarProductos();
    }

    private async Task AlPresionarTecla(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;

        demora?.Cancel();
        await CargarProductos();
        var primero = resultados.FirstOrDefault(p => p.Stock - CantidadEnTicket(p.Id) > 0);
        if (primero != null)
        {
            Agregar(primero);
            busqueda = "";
            await CargarProductos();
        }
    }

    private async Task CargarProductos()
    {
        cargando = true;
        try
        {
            var texto = Uri.EscapeDataString(busqueda.Trim());
            var pagina = await Api.GetAsync<PagedResult<ProductoItem>>($"api/productos?pageSize=24&nombre={texto}");
            resultados = pagina?.Items ?? new();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    // ---- Ticket ----

    private void Agregar(ProductoItem p)
    {
        error = null;
        var linea = carrito.FirstOrDefault(l => l.Producto.Id == p.Id);
        if (linea == null)
            carrito.Add(new LineaCarrito { Producto = p, Cantidad = 1 });
        else if (linea.Cantidad < p.Stock)
            linea.Cantidad++;
        else
            error = $"No hay más stock de {p.Nombre}.";
    }

    private void Cambiar(LineaCarrito linea, int delta)
    {
        error = null;
        var nueva = linea.Cantidad + delta;
        if (nueva <= 0) carrito.Remove(linea);
        else if (nueva > linea.Producto.Stock) error = $"No hay más stock de {linea.Producto.Nombre}.";
        else linea.Cantidad = nueva;
    }

    private void Quitar(LineaCarrito linea) => carrito.Remove(linea);

    private void Vaciar()
    {
        carrito.Clear();
        error = null;
    }

    // ---- Cliente ----

    private async Task AbrirSelectorCliente()
    {
        eligiendoCliente = true;
        busquedaCliente = "";
        await CargarClientes();
    }

    private async Task BuscarClientes(ChangeEventArgs e)
    {
        busquedaCliente = e.Value?.ToString() ?? "";
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        try
        {
            var texto = Uri.EscapeDataString(busquedaCliente.Trim());
            var pagina = await Api.GetAsync<PagedResult<ClienteItem>>($"api/clientes?pageSize=8&buscar={texto}");
            clientes = pagina?.Items ?? new();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private void ElegirCliente(ClienteItem? c)
    {
        cliente = c;
        eligiendoCliente = false;
    }

    // ---- Cobro ----

    private async Task Cobrar()
    {
        if (carrito.Count == 0) return;

        error = null;
        procesando = true;
        try
        {
            var cuerpo = new
            {
                clienteId = cliente?.Id,
                detalles = carrito.Select(l => new { productoId = l.Producto.Id, cantidad = l.Cantidad }).ToList()
            };
            ticket = await Api.PostAsync<VentaVista>("api/ventas", cuerpo);
            carrito.Clear();
            cliente = null;
        }
        catch (ApiException ex)
        {
            // Por ejemplo: otra caja vendió la última unidad mientras armábamos el ticket
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }

        await CargarProductos();
    }

    private async Task Imprimir() => await JS.InvokeVoidAsync("print");

    private async Task NuevaVenta()
    {
        ticket = null;
        StateHasChanged();
        await Task.Yield();
        await EnfocarBuscador();
    }

    public void Dispose()
    {
        demora?.Cancel();
        demora?.Dispose();
    }
}
