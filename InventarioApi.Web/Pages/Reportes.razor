@page "/reportes"
@attribute [Authorize(Roles = "Admin")]
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Reportes · Caja y Stock</PageTitle>

<header class="encabezado">
    <h1>Reportes</h1>
    <p>Generá los reportes en PDF para consultarlos en pantalla, descargarlos o enviarlos por correo.</p>
</header>

@if (error != null)
{
    <div class="alerta alerta-error">@error</div>
}
@if (exito != null)
{
    <div class="alerta alerta-ok">@exito</div>
}

<section class="panel panel-envio">
    <label class="campo">
        <span>Enviar los reportes a</span>
        <input type="email" @bind="email" @bind:event="oninput" placeholder="correo@ejemplo.com" />
    </label>
    <p class="nota">Por defecto se completa con el email de tu usuario.</p>
</section>

<div class="reportes">
    @foreach (var r in opciones)
    {
        <section class="panel">
            <h2 class="panel-titulo">@r.Titulo</h2>
            <p class="reporte-descripcion">@r.Descripcion</p>

            @if (r.ConPeriodo)
            {
                <div class="reporte-periodo">
                    <label class="campo"><span>Desde</span><input type="date" @bind="r.Desde" /></label>
                    <label class="campo"><span>Hasta</span><input type="date" @bind="r.Hasta" /></label>
                </div>
            }

            <div class="acciones">
                <button class="boton boton-primario" disabled="@(ocupado != null)" @onclick="() => Ver(r)">
                    @(ocupado == r.Tipo + ":ver" ? "Generando…" : "Ver PDF")
                </button>
                <button class="boton boton-fantasma" disabled="@(ocupado != null)" @onclick="() => Enviar(r)">
                    @(ocupado == r.Tipo + ":enviar" ? "Enviando…" : "Enviar por correo")
                </button>
            </div>
        </section>
    }
</div>

@if (urlPdf != null)
{
    <div class="modal-fondo">
        <div class="modal-caja modal-pdf" role="dialog" aria-labelledby="pdf-titulo">
            <div class="modal-pdf-titulo">
                <h2 id="pdf-titulo">@tituloPdf</h2>
                <div class="acciones">
                    <button class="boton boton-fantasma" @onclick="Descargar">Descargar</button>
                    <button class="boton boton-primario" @onclick="CerrarPdf">Cerrar</button>
                </div>
            </div>
            <iframe src="@urlPdf" title="@tituloPdf"></iframe>
        </div>
    </div>
}

@code {
    private class OpcionReporte
    {
        public string Tipo { get; init; } = "";
        public string Titulo { get; init; } = "";
        public string Descripcion { get; init; } = "";
        public bool ConPeriodo { get; init; }
        public DateTime? Desde { get; set; }
        public DateTime? Hasta { get; set; }
    }

    private List<OpcionReporte> opciones = new();
    private string email = "";
    private string? ocupado;
    private string? error;
    private string? exito;

    private string? urlPdf;
    private string tituloPdf = "";
    private string nombrePdf = "reporte.pdf";

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateTime.Today;
        var inicioMes = new DateTime(hoy.Year, hoy.Month, 1);

        opciones = new()
        {
            new OpcionReporte
            {
                Tipo = "stock",
                Titulo = "Stock",
                Descripcion = "Existencias actuales de cada producto, valorizadas a precio de venta, con los productos en falta resaltados."
            },
            new OpcionReporte
            {
                Tipo = "ventas",
                Titulo = "Ventas",
                Descripcion = "Salidas del período: cantidad de ventas, total facturado, productos más vendidos y detalle de cada ticket.",
                ConPeriodo = true, Desde = inicioMes, Hasta = hoy
            },
            new OpcionReporte
            {
                Tipo = "ingresos",
                Titulo = "Ingresos de mercadería",
                Descripcion = "Entradas del período: compras a proveedores, unidades ingresadas y costo total por producto.",
                ConPeriodo = true, Desde = inicioMes, Hasta = hoy
            }
        };

        try
        {
            var yo = await Api.GetAsync<UsuarioActual>("api/auth/yo");
            email = yo?.Email ?? "";
        }
        catch (ApiException) { /* si falla, se completa a mano */ }
    }

    private static string Url(OpcionReporte r) =>
        r.ConPeriodo
            ? $"api/reportes/{r.Tipo}?desde={r.Desde:yyyy-MM-dd}&hasta={r.Hasta:yyyy-MM-dd}"
            : $"api/reportes/{r.Tipo}";

    private bool PeriodoValido(OpcionReporte r)
    {
        if (!r.ConPeriodo) return true;
        if (r.Desde == null || r.Hasta == null) { error = "Elegí las dos fechas del período."; return false; }
        if (r.Desde > r.Hasta) { error = "La fecha 'desde' no puede ser posterior a 'hasta'."; return false; }
        return true;
    }

    private async Task Ver(OpcionReporte r)
    {
        error = null;
        exito = null;
        if (!PeriodoValido(r)) return;

        ocupado = r.Tipo + ":ver";
        try
        {
            var bytes = await Api.GetArchivoAsync(Url(r));
            await LiberarPdf();
            urlPdf = await JS.InvokeAsync<string>("archivos.crearUrl", bytes, "application/pdf");
            tituloPdf = $"Reporte de {r.Titulo.ToLowerInvariant()}";
            nombrePdf = r.ConPeriodo
                ? $"{r.Tipo}_{r.Desde:yyyyMMdd}_{r.Hasta:yyyyMMdd}.pdf"
                : $"{r.Tipo}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { ocupado = null; }
    }

    private async Task Enviar(OpcionReporte r)
    {
        error = null;
        exito = null;
        if (!PeriodoValido(r)) return;
        if (string.IsNullOrWhiteSpace(email)) { error = "Completá el email al que querés enviar el reporte."; return; }

        ocupado = r.Tipo + ":enviar";
        try
        {
            var respuesta = await Api.PostAsync<MensajeRespuesta>($"api/reportes/{r.Tipo}/enviar", new
            {
                email = email.Trim(),
                desde = r.ConPeriodo ? r.Desde : null,
                hasta = r.ConPeriodo ? r.Hasta : null
            });
            exito = respuesta?.Mensaje ?? "Reporte enviado.";
        }
        catch (ApiException ex) { error = ex.Message; }
        finally { ocupado = null; }
    }

    private async Task Descargar()
    {
        if (urlPdf != null) await JS.InvokeVoidAsync("archivos.descargar", urlPdf, nombrePdf);
    }

    private async Task CerrarPdf() => await LiberarPdf();

    private async Task LiberarPdf()
    {
        if (urlPdf == null) return;
        var url = urlPdf;
        urlPdf = null;
        try { await JS.InvokeVoidAsync("archivos.liberarUrl", url); } catch { }
    }

    public async ValueTask DisposeAsync() => await LiberarPdf();
}
