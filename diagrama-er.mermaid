erDiagram
    ROL ||--o{ USUARIO : asigna
    CLIENTE ||--o| USUARIO : "cuenta de la app"
    CATEGORIA ||--o{ PRODUCTO : clasifica
    PRODUCTO ||--o{ DETALLE_COMPRA : incluye
    PRODUCTO ||--o{ DETALLE_VENTA : incluye
    PROVEEDOR ||--o{ COMPRA : provee
    CLIENTE ||--o{ VENTA : realiza
    USUARIO ||--o{ COMPRA : registra
    USUARIO ||--o{ VENTA : registra
    COMPRA ||--|{ DETALLE_COMPRA : contiene
    VENTA ||--|{ DETALLE_VENTA : contiene
    VENTA ||--o| PAGO : "se paga con"
    MEDIO_PAGO ||--o{ PAGO : "medio de"
    USUARIO |o--o{ AUDITORIA : genera
    USUARIO |o--o{ LOG_ERROR : asociado

    ROL {
        int Id PK
        string Nombre UK
    }

    USUARIO {
        int Id PK
        string NombreUsuario UK
        string PasswordHash
        string Email
        bool Activo
        int RolId FK
        int ClienteId FK "UK, admite NULL"
    }

    CATEGORIA {
        int Id PK
        string Nombre UK
        string Descripcion
    }

    PRODUCTO {
        int Id PK
        string Nombre
        string Descripcion
        decimal Precio
        int Stock
        string ImagenUrl
        bool Activo
        int CategoriaId FK
    }

    PROVEEDOR {
        int Id PK
        string RazonSocial
        string Contacto
        string Telefono
        string Email
        string Direccion
    }

    CLIENTE {
        int Id PK
        string Nombre
        string Apellido
        string Email
        string Telefono
        string Direccion
    }

    COMPRA {
        int Id PK
        datetime Fecha
        int ProveedorId FK
        int UsuarioId FK
    }

    DETALLE_COMPRA {
        int Id PK
        int CompraId FK
        int ProductoId FK
        int Cantidad
        decimal PrecioUnitario
    }

    VENTA {
        int Id PK
        datetime Fecha
        int ClienteId FK
        int UsuarioId FK
        string Canal "Caja o App"
    }

    DETALLE_VENTA {
        int Id PK
        int VentaId FK
        int ProductoId FK
        int Cantidad
        decimal PrecioUnitario
    }

    MEDIO_PAGO {
        int Id PK
        string Nombre UK
        bool RequiereTarjeta
        bool PermiteCuotas
    }

    PAGO {
        int Id PK
        int VentaId FK "UK"
        int MedioPagoId FK
        int Cuotas
        string UltimosDigitos
        string CodigoAutorizacion
    }

    AUDITORIA {
        int Id PK
        datetime Fecha
        int UsuarioId FK
        string Accion
        string Entidad
        int EntidadId
        string Detalle
    }

    LOG_ERROR {
        int Id PK
        datetime Fecha
        string Mensaje
        string Detalle
        string Ruta
        int UsuarioId FK
    }
