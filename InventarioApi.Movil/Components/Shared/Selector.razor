@* Selector de cantidad: −  2  + *@
<div class="selector">
    <button type="button" disabled="@(Valor <= Minimo)" @onclick="() => Cambiar(Valor - 1)" aria-label="Restar uno">
        <Icono Nombre="menos" Tamanio="18" />
    </button>
    <span class="selector-valor">@Valor</span>
    <button type="button" disabled="@(Valor >= Maximo)" @onclick="() => Cambiar(Valor + 1)" aria-label="Sumar uno">
        <Icono Nombre="mas" Tamanio="18" />
    </button>
</div>

@code {
    [Parameter] public int Valor { get; set; }
    [Parameter] public EventCallback<int> ValorChanged { get; set; }
    [Parameter] public int Minimo { get; set; } = 1;
    [Parameter] public int Maximo { get; set; } = 99;

    private async Task Cambiar(int nuevo)
    {
        nuevo = Math.Clamp(nuevo, Minimo, Math.Max(Minimo, Maximo));
        if (nuevo != Valor) await ValorChanged.InvokeAsync(nuevo);
    }
}
